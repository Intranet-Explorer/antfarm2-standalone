<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.antfarm2.watchdog</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/octo/antfarm2-standalone/watchdog.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/octo/antfarm2-standalone</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/octo/antfarm2-standalone/watchdog.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/octo/antfarm2-standalone/watchdog.launchd.log</string>
    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
